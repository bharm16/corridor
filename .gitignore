.venv/
__pycache__/
*.pyc
.pytest_cache/
.env

# Fetched corpus documents: content-addressed, reproducible from the
# manifest, and far too large to track.
corpus/files/

# Demo output: regenerated by `make demo`.
out/

# Synthesized CloudFormation: regenerated by `cdk synth`. Ignored here rather
# than in infra/ so that it stays ignored on a branch that does not carry
# infra/ at all -- a nested rule disappears with the checkout that removes it,
# which is how 10k lines of build output once surfaced on main.
infra/cdk.out/

# The pinned CDK CLI, installed with `npm ci` from infra/package-lock.json.
# Ignored at the root for the same reason as cdk.out above: a rule that lives
# inside infra/ disappears with any checkout that does not carry infra/.
infra/node_modules/

# Local research notes, not part of the tracked record.
docs/research/lean-extraction-storage-model-2026-08-30.md

# The reader package's answer-key printer needs `ssf` from npm, installed by
# `make pdf-reader-node` from the committed package-lock.json (#729), and its
# reference builder writes scratch workbooks under the package's tmp/.
src/corridor_pdf_reader/paired_trial/node_modules/
src/corridor_pdf_reader/tmp/

# macOS Finder metadata.
.DS_Store

# The engine-absent proof environments built by `make test-engine-absent`:
# copies of both uv projects that never receive PyMuPDF or pytesseract.
.venv-engine-absent/
