# Defaults match docker-compose.yml; copy to .env only to override.
DATABASE_URL=postgresql+psycopg://corridor:corridor@localhost:5433/corridor

# Create the legacy-development database login (#492).  It is the only
# credential that can write the frozen legacy accepted tables, so a customer
# deployment leaves this unset and has no such credential at all.
CORRIDOR_LEGACY_DEV_LOGIN=1
