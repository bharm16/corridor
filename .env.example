# Defaults match docker-compose.yml; copy to .env only to override.
DATABASE_URL=postgresql+psycopg://corridor:corridor@localhost:5433/corridor

# Create the legacy-development database login (#492).  It is the only
# credential that can write the frozen legacy accepted tables, so a customer
# deployment leaves this unset and has no such credential at all.
CORRIDOR_LEGACY_DEV_LOGIN=1

# Runtime database credentials (#492). DATABASE_URL is the migration and DDL
# credential that owns the schema; no application process uses it. Left unset,
# each capability URL below is derived from DATABASE_URL by swapping in that
# capability's login.
#
# Local development runs legacy projects, whose accepted tables only
# corridor_legacy_dev may write, so point the web application at that login
# here. A customer deployment has no legacy projects and leaves this unset, so
# the application runs as corridor_web and can write no legacy accepted table
# at all.
CORRIDOR_WEB_DATABASE_URL=postgresql+psycopg://corridor_legacy_dev:corridor_legacy_dev@localhost:5433/corridor
CORRIDOR_WORKER_DATABASE_URL=postgresql+psycopg://corridor_legacy_dev:corridor_legacy_dev@localhost:5433/corridor
