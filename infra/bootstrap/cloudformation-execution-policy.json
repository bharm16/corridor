{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProvisionCorridorRolesUnderItsOwnPath",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:UpdateRoleDescription"
      ],
      "Resource": "arn:aws:iam::810100779593:role/corridor/nonproduction/*"
    },
    {
      "Sid": "EveryCorridorRoleCarriesTheBoundary",
      "Effect": "Deny",
      "Action": ["iam:CreateRole", "iam:PutRolePermissionsBoundary"],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::810100779593:policy/CorridorNonproductionBoundary"
        }
      }
    },
    {
      "Sid": "ReadAnyRoleSoDriftDetectionWorks",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:ListRoleTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassRolesOnlyToTheServicesThatRunThem",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::810100779593:role/corridor/nonproduction/*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ecs-tasks.amazonaws.com",
            "vpc-flow-logs.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "TheGitHubOidcProvider",
      "Effect": "Allow",
      "Action": [
        "iam:AddClientIDToOpenIDConnectProvider",
        "iam:CreateOpenIDConnectProvider",
        "iam:DeleteOpenIDConnectProvider",
        "iam:GetOpenIDConnectProvider",
        "iam:TagOpenIDConnectProvider",
        "iam:UpdateOpenIDConnectProviderThumbprint"
      ],
      "Resource": "arn:aws:iam::810100779593:oidc-provider/token.actions.githubusercontent.com"
    },
    {
      "Sid": "ServiceLinkedRolesOnlyForServicesCorridorUses",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "elasticloadbalancing.amazonaws.com",
            "rds.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "NeverLongLivedIdentities",
      "Effect": "Deny",
      "Action": [
        "iam:CreateAccessKey",
        "iam:CreateLoginProfile",
        "iam:CreateUser",
        "iam:CreateServiceSpecificCredential"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NeverAccountOrOrganizationChanges",
      "Effect": "Deny",
      "Action": [
        "account:*",
        "aws-portal:*",
        "organizations:*"
      ],
      "Resource": "*"
    }
  ]
}
